#include <iostream>
using namespace std;

int main() {
    int n = 4;
    int arr[n][n] = {{1,2,4,8},{9,10,11,12},{15,17,19,21},{28,31,40,50}};
    
    int target;
    cin >> target;

    int row = 0, col = n - 1; 
    bool found = false;

    while (row < n && col >= 0) {
        if (arr[row][col] == target) {
            cout << "Element found at " << row << "," << col << endl;
            found = true;
            break;
        }
        else if (arr[row][col] > target)
            col--; 
        else
            row++; 
    }

    if (!found)
        cout << "Element not found" << endl;

    return 0;
}
